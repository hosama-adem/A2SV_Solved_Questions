t = int(input())

for _ in range(t):
    n, q = map(int, input().split())
    a = list(map(int, input().split()))

    pre = [0] * (n + 1)
    for i in range(n):
        pre[i + 1] = pre[i] + a[i]

    su = sum(a)

    for _ in range(q):
        l, r, k = map(int, input().split())
        o_s = pre[r] - pre[l - 1]
        n_s = su - o_s + (r - l + 1) * k

        if n_s % 2 == 1:
            print("YES")
        else:
            print("NO")
